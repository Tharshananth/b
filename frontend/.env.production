# REACT_APP_API_URL is deliberately left unset.
#
# Create React App bakes env vars in at build time, so setting it here pins one
# build to one host - a build made for 4.213.16.34 would still call that IP when
# opened at localhost. With it unset, Chatbot.jsx falls back to
#   http://<the host you opened the page on>:8000
# so a single build works on the server and locally.
#
# Set it only when the API lives on a different host from the page - a separate
# API domain, or a port other than 8000.
# REACT_APP_API_URL=http://4.213.16.34:8000

PORT=5000
HOST=0.0.0.0
