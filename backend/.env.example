JWT_SECRET=<generate with: python -c "import secrets; print(secrets.token_urlsafe(48))">
ADMIN_TOKEN_TTL_MINUTES=60
ENABLE_API_DOCS=false

REDIS_URL=redis://localhost:6379/0
# Production example: redis://:<password>@<host>:6379/0
# Azure Cache for Redis: rediss://:<access-key>@<name>.redis.cache.windows.net:6380/0

